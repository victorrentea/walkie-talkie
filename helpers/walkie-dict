            out.append(f"<li><time>{esc(local_time(ts))}</time> <span class=ev>{esc(s.get('evidence', ''))}</span> "
                       f"“{esc(s.get('quote', ''))}”<div class=said>{esc(s.get('dictation', ''))}</div></li>")
        return "<ul class=sight>" + "".join(out) + "</ul>" if out else ""

    # One add writes the word and its `heard → word` pair; the pair's row says both.
    paired = {key(r["right"]) for r in log if r.get("heard")}
    paired |= {key(e[1]) for e in (parse_line(l) for l in lines) if e and e[1]}
    rows, section, synced, counts = [], "", False, {}
