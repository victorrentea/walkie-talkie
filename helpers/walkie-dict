#!/usr/bin/env python3
"""walkie-dict — one dictionary for both engines (2026-11-09).

    walkie-dict add "<right>" [--heard "<as it came out>"]   # both dictionaries, then sync
    walkie-dict sync [--dry-run]                             # merge both ways (Victor Addons, every 10 min)
    walkie-dict show [--no-open]                             # the dictionary as a page: who taught each word, when
    walkie-dict backfill                                     # the adds agents made before the log, from their transcripts

**Why.** Victor, 2026-11-09: *"când modelul este 100% sigur … că mesajul dictat conține
un cuvânt greșit … Claude să poată adăuga în dicționarul folosit de Walkie Talkie
cuvântul … inclusiv în Wispr Flow Dictionary … dicționarul local și cel al Wispr
Flow-ului să fie în sync"*. The trigger was "Wispr Flow" heard as "Whisperflow". Every
dictated prompt carries `AppDelegate.dictionaryHint`, which tells the agent to run `add`.

**The two dictionaries.**
- local: `~/.walkie-talkie/vocabulary.txt`, read by the ✍️ editor (`DictationEditor`):
  one term a line, `heard → written` for a replacement.
- Wispr: the `Dictionary` table of `~/Library/Application Support/Wispr Flow/flow.sqlite`
  (personal team id, `isSnippet = 0`). `phrase` is what is heard, `replacement` what is
  written (NULL for a plain term) — the same pair as a local `→` line.

**Writing into Wispr's table is how Wispr's own sync works.** `DictionaryManager.syncDictionary`
(app.asar) pushes every local row the server lacks (by id, or by phrase + team) to
`POST /api/v1/dictionary/personal` and pulls the rest, so a row added here reaches the
cloud and the other devices. It runs at Wispr's start and after any dictionary action in
its Hub (the ⟳ sync button there too) — until then the running Wispr keeps its cached list,
so a word added now is used by Wispr from its next start or Hub sync, by the ✍️ editor at
once. Wispr itself is never touched (no kill, no restart: `feedback_leave_wispr_flow_alone`).

**Three-way merge** against `~/.walkie-talkie/vocabulary-sync.json`, the set both sides
agreed on last time: present on one side and not in the base → added to the other; in the
base but gone from one side → deleted from the other (Wispr: `isDeleted = 1`, which its
sync propagates). Wispr's auto-learned rows (`source = user_edits`: `fix.yv`, `test.gl`,
`exfiltration.com?pass`…) and snippets are not pulled into the local file. Stdlib only.
"""
import datetime
import fcntl
import json
import os
import re
import sqlite3
import sys
import tempfile
import uuid

HOME = os.path.expanduser("~/.walkie-talkie")
VOCAB = os.path.join(HOME, "vocabulary.txt")
BASE = os.path.join(HOME, "vocabulary-sync.json")
LOCK = os.path.join(HOME, "vocabulary-sync.lock")
WISPR_DB = os.path.expanduser("~/Library/Application Support/Wispr Flow/flow.sqlite")
PERSONAL = "00000000-0000-0000-0000-000000000000"
SECTION = "# Synced with Wispr Flow (walkie-dict)"


def key(phrase):
    return phrase.strip().lower()


# ---- local file -------------------------------------------------------------------------

def parse_line(raw):
    """Same rules as `DictationEditor.parseVocabulary`: (heard, written|None) or None."""
    l = raw.strip()
    if not l or l.startswith("#"):
        return None
    if " #" in l:
        l = l[: l.index(" #")].strip()
    for arrow in ("→", "->"):
        if arrow in l:
            heard, written = (p.strip() for p in l.split(arrow, 1))
            return (heard, written) if heard and written else None
    return (l, None)


def read_local():
    lines = open(VOCAB, encoding="utf-8").read().split("\n") if os.path.exists(VOCAB) else []
    entries = {}
    for raw in lines:
        e = parse_line(raw)
        if e:
            entries.setdefault(key(e[0]), e)
    return lines, entries


def render(e):
    return f"{e[0]} → {e[1]}" if e[1] else e[0]


def write_local(lines, adds, removes, changes):
    out = []
    for raw in lines:
        e = parse_line(raw)
        if e and key(e[0]) in removes:
            continue
        if e and key(e[0]) in changes:
            out.append(render(changes.pop(key(e[0]))))
            continue
        out.append(raw)
    while out and out[-1] == "":
        out.pop()
    if adds:
        if SECTION not in out:
            out += ["", SECTION]
        out += [render(e) for e in adds]
    fd, tmp = tempfile.mkstemp(dir=HOME, prefix=".vocabulary.")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")
    os.replace(tmp, VOCAB)


# ---- Wispr ------------------------------------------------------------------------------

def now():
    t = datetime.datetime.now(datetime.timezone.utc)
    return t.strftime("%Y-%m-%d %H:%M:%S.") + f"{t.microsecond // 1000:03d} +00:00"


def wispr():
    db = sqlite3.connect(WISPR_DB, timeout=10)
    db.execute("PRAGMA busy_timeout = 10000")
    return db


def read_wispr(db):
    """Active rows by key, and every row by key (deleted and auto-learned included)."""
    active, every = {}, {}
    for phrase, repl, source, deleted in db.execute(
            "SELECT phrase, replacement, source, isDeleted FROM Dictionary "
            "WHERE teamDictionaryId = ? AND isSnippet = 0", (PERSONAL,)):
        k = key(phrase)
        every[k] = (phrase, repl, source, deleted)
        if not deleted:
            active[k] = (phrase.strip(), repl, source)
    return active, every


def wispr_put(db, every, heard, written):
    k, t = key(heard), now()
    row = every.get(k)
    if row:
        db.execute("UPDATE Dictionary SET replacement = ?, isDeleted = 0, manualEntry = 1, "
                   "source = 'manual', modifiedAt = ? WHERE phrase = ? AND teamDictionaryId = ?",
                   (written, t, row[0], PERSONAL))
    else:
        db.execute("INSERT INTO Dictionary (id, phrase, replacement, teamDictionaryId, lastUsed, "
                   "frequencyUsed, remoteFrequencyUsed, manualEntry, createdAt, modifiedAt, isDeleted, "
                   "source, isSnippet, isStarred) VALUES (?, ?, ?, ?, NULL, 0, 0, 1, ?, ?, 0, 'manual', 0, 0)",
                   (str(uuid.uuid4()), heard, written, PERSONAL, t, t))


def wispr_delete(db, every, k):
    db.execute("UPDATE Dictionary SET isDeleted = 1, frequencyUsed = 0, modifiedAt = ? "
               "WHERE phrase = ? AND teamDictionaryId = ?", (now(), every[k][0], PERSONAL))


# ---- merge ------------------------------------------------------------------------------

def sync(dry=False, quiet=False):
    lines, local = read_local()
    base = json.load(open(BASE)) if os.path.exists(BASE) else {}
    db = wispr()
    active, every = read_wispr(db)
    log = []
    l_add, l_rm, l_chg = [], set(), {}
    w_put, w_rm = [], []
    for k in sorted(set(local) | set(active) | set(base)):
        L, W, B = local.get(k), active.get(k), base.get(k)
        if L and W:
            if (L[1] or None) != (W[1] or None):
                if B is not None and (W[1] or None) == B and (L[1] or None) != B:
                    w_put.append(L); log.append(f"wispr  ✎ {render(L)}")
                elif B is not None and (L[1] or None) == B:
                    l_chg[k] = (L[0], W[1]); log.append(f"local  ✎ {render((L[0], W[1]))}")
                else:  # first meeting, or both edited: the file wins, it is the one Claude writes
                    w_put.append(L); log.append(f"wispr  ✎ {render(L)}")
        elif L:
            if k in base:
                l_rm.add(k); log.append(f"local  − {render(L)}   (deleted in Wispr)")
            else:
                w_put.append(L); log.append(f"wispr  + {render(L)}")
        elif W:
            if k in base:
                w_rm.append(k); log.append(f"wispr  − {render(W)}   (deleted locally)")
            elif W[2] != "user_edits":
                l_add.append((W[0], W[1])); log.append(f"local  + {render(W)}")
    if not quiet or log:
        print("\n".join(log) if log else "in sync")
    if dry:
        return
    if w_put or w_rm:
        with db:
            for e in w_put:
                wispr_put(db, every, e[0], e[1])
            for k in w_rm:
                wispr_delete(db, every, k)
    if l_add or l_rm or l_chg:
        write_local(lines, l_add, l_rm, l_chg)
    # The new base: every key both sides now hold (auto-learned Wispr rows stay out of it).
    _, local = read_local()
    active, _ = read_wispr(db)
    agreed = {k: (local[k][1] or None) for k in local if k in active}
    tmp = BASE + ".tmp"
    json.dump(agreed, open(tmp, "w"), ensure_ascii=False, indent=0, sort_keys=True)
    os.replace(tmp, BASE)


def add(right, heard=None):
    lines, local = read_local()
    adds = []
    if key(right) not in local:
        adds.append((right, None))
    if heard and key(heard) != key(right):
        if key(heard) in local and local[key(heard)][1] != right:
            write_local(lines, [], set(), {key(heard): (heard, right)}); lines, local = read_local()
        elif key(heard) not in local:
            adds.append((heard, right))
    if adds:
        write_local(lines, adds, set(), {})
    log_add(right, heard)
    sync(quiet=True)
    print(f"✓ {right}" + (f"  ({heard} → {right})" if heard else "") +
          " — ✍️ editor now; Wispr from its next start or Hub sync")


# ---- provenance and the page (2026-11-19) -------------------------------------------------
#
# Victor: *"aș vrea să existe un mode în care să văd și dicționarul redactorului, ideal și cu
# sursa+timpul când a fost învățat sau dedus"*. `vocabulary.txt` holds no provenance, so it is
# put together from what each writer leaves behind:
#   - `vocabulary-log.jsonl` — every `add` from now on: when, who (`WALKIE_DICT_BY`, else the
#     agent found up the process tree), its Claude session and folder; `backfill` writes the same
#     records for the adds agents made before the log, read off their transcripts;
#   - `dict-harvest/ledger.json` — what the weekly harvest deduced from transcripts, with the
#     sightings (quote + the dictation it came from), promoted or still counting;
#   - Wispr's own `Dictionary` rows — `createdAt`, `source` (`manual`, `user_edits` = learned from
#     his corrections, `default`), how often it was used;
#   - the seed — the lines above the synced section, written 2026-10-22.

ADD_LOG = os.path.join(HOME, "vocabulary-log.jsonl")
LEDGER = os.path.join(HOME, "dict-harvest", "ledger.json")
PAGE = os.path.expanduser("~/Library/Caches/ro.victorrentea.wispr-relay/dictionary.html")
PROJECTS = os.path.expanduser("~/.claude/projects")


def caller():
    """The agent that ran us: the first claude / codex / copilot up the process tree."""
    import subprocess
    pid = os.getppid()
    for _ in range(12):
        try:
            out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)],
                                 capture_output=True, text=True, timeout=2).stdout.strip()
        except Exception:
            return None
        if not out:
            return None
        ppid, comm = out.split(None, 1)
        name = os.path.basename(comm).lower()
        for agent in ("claude", "codex", "copilot", "cursor"):
            if agent in name:
                return agent
        pid = int(ppid)
        if pid <= 1:
            return None
    return None


def log_add(right, heard, **extra):
    rec = {"ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
           "right": right, "heard": heard,
           "by": os.environ.get("WALKIE_DICT_BY") or caller() or "shell",
           "session": os.environ.get("CLAUDE_CODE_SESSION_ID"), "cwd": os.getcwd()}
    rec.update(extra)
    try:
        with open(ADD_LOG, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except OSError:
        pass


def read_log():
    out = []
    if os.path.exists(ADD_LOG):
        for line in open(ADD_LOG, encoding="utf-8"):
            try:
                out.append(json.loads(line))
            except ValueError:
                pass
    return out


ADD_CALL = re.compile(r"""(?:^|[;&|(\n]\s*)walkie-dict\s+add\s+(.*)""")


def parse_add(cmd):
    """`walkie-dict add "<right>" [--heard "<heard>"]` inside a shell command → (right, heard)."""
    import shlex
    m = ADD_CALL.search(cmd)
    if not m:
        return None
    rest = re.split(r"\s(?:2>|>|\||&&|;)", " " + m.group(1))[0].strip()
    try:
        args = shlex.split(rest)
    except ValueError:
        return None
    if not args or args[0].startswith("-"):
        return None
    heard = args[args.index("--heard") + 1] if "--heard" in args[:-1] else None
    return args[0], heard


def spoken(content):
    """A user turn's own words — not a tool result, not a skill's body."""
    if isinstance(content, list):
        content = "\n".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")
    if not isinstance(content, str) or not content.strip():
        return None
    if content.startswith(("Base directory for this skill", "<command-", "<local-command", "Caveat:")):
        return None
    return content


def transcript_adds(path, want=None):
    """Every `walkie-dict add` a transcript ran: (ts, right, heard, cwd, session, the prompt before it)."""
    found, prompt = [], None
    try:
        data = open(path, encoding="utf-8").read()
    except OSError:
        return found
    if "walkie-dict" not in data:
        return found
    for line in data.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") == "user":
            prompt = spoken(e.get("message", {}).get("content")) or prompt
        if e.get("type") != "assistant":
            continue
        for b in e.get("message", {}).get("content") or []:
            if not (isinstance(b, dict) and b.get("type") == "tool_use" and b.get("name") == "Bash"):
                continue
            call = parse_add(b.get("input", {}).get("command", ""))
            if call and (want is None or key(call[0]) == key(want)):
                found.append({"ts": (e.get("timestamp") or "")[:19] + "Z", "right": call[0], "heard": call[1],
                              "cwd": e.get("cwd"), "session": e.get("sessionId"), "prompt": (prompt or "")[:600]})
    return found


def backfill():
    """The adds made before the log existed, read off the Claude transcripts since walkie-dict."""
    import glob
    since = os.path.getmtime(os.path.realpath(__file__)) - 30 * 86400
    have = {(r.get("right"), (r.get("ts") or "")[:16]) for r in read_log()}
    new = []
    for path in glob.glob(os.path.join(PROJECTS, "*", "*.jsonl")):
        if os.path.getmtime(path) < since:
            continue
        for r in transcript_adds(path):
            # An eval's sandbox ran it under `WALKIE_EVAL_LOG`: nothing was added.
            if any(t in (r.get("cwd") or "") for t in ("/evals/", "/tmp/", "/var/folders/", "/private/")):
                continue
            if (r["right"], r["ts"][:16]) not in have:
                have.add((r["right"], r["ts"][:16]))
                new.append(dict(r, by="claude", backfilled=True))
    new.sort(key=lambda r: r["ts"])
    with open(ADD_LOG, "a", encoding="utf-8") as f:
        for r in new:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")
    print(f"{len(new)} add(s) recovered from transcripts → {ADD_LOG}")


def prompt_of(rec):
    """The words that led to a logged add: read once from its session's transcript."""
    if rec.get("prompt") or not rec.get("session"):
        return rec.get("prompt")
    import glob
    for path in glob.glob(os.path.join(PROJECTS, "*", rec["session"] + ".jsonl")):
        hits = transcript_adds(path, want=rec["right"])
        if hits:
            return hits[-1]["prompt"]
    return None


def wispr_rows():
    rows = {}
    try:
        db = sqlite3.connect(f"file:{WISPR_DB}?mode=ro", uri=True, timeout=5)
        for phrase, repl, source, created, used, last in db.execute(
                "SELECT phrase, replacement, source, createdAt, frequencyUsed + remoteFrequencyUsed, lastUsed "
                "FROM Dictionary WHERE teamDictionaryId = ? AND isSnippet = 0 AND isDeleted = 0", (PERSONAL,)):
            rows[key(phrase)] = {"phrase": phrase, "replacement": repl, "source": source,
                                 "created": created, "used": used or 0, "last": last}
    except sqlite3.Error:
        pass
    return rows


def local_time(ts):
    if not ts:
        return ""
    t = ts.strip().replace(" +00:00", "+00:00").replace("Z", "+00:00")
    for fmt in ("%Y-%m-%dT%H:%M:%S%z", "%Y-%m-%d %H:%M:%S.%f%z", "%Y-%m-%dT%H:%M:%S.%f%z", "%Y-%m-%d"):
        try:
            d = datetime.datetime.strptime(t, fmt)
            if d.tzinfo:
                d = d.astimezone()
                return d.strftime("%Y-%m-%d %H:%M")
            return d.strftime("%Y-%m-%d")
        except ValueError:
            continue
    return ts[:16]


def clean(prompt):
    """The dictation without its envelope rows (`🎤 · 💻`, `[dictated …]`, `[📁=…]`)."""
    if not prompt:
        return prompt
    keep = [l for l in prompt.split("\n")
            if not (l.strip() and len(l) < 40 and not re.search(r"[^\W\d_]", l))   # `🎤 · 💻 · 📸 ×1`
            and not re.match(r"\s*(\[dictated|\[Transcribed|\[📁|\[📸\d+ (?:auto|at)|🎤 ·|\[a question)", l)]
    return "\n".join(keep).strip()


def marked(text, heard):
    """`text` escaped, with what was misheard highlighted."""
    import html
    out = html.escape(text)
    if heard:
        out = re.sub(re.escape(html.escape(heard)), lambda m: f"<mark>{m.group(0)}</mark>", out, flags=re.I)
    return out


