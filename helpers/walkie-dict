        term = (f"<s>{esc(heard)}</s> → <b>{esc(written)}</b>" if written else f"<b>{esc(heard)}</b>")
        rows.append((local_time(when), f"<tr class='{cls}'><td class=term>{term}</td><td><span class='badge {cls}'>{esc(badge)}</span>"
