#!/usr/bin/env python3
"""walkie-reply "<answer>" [--image <path>]… — show a short answer beside Victor's mouse (2026-10-07).

`--image` (2026-10-09, repeatable): a small picture rides the answer — thumbnails under
the words, as many as fit; a click opens one full size. PNG/JPEG/GIF/TIFF/HEIC/PDF.

A prompt he dictated with a `?` in it carries the footer line
`[If I asked you a question, also run: walkie-reply "<the answer in ≤2 short sentences>". Only to answer me — never to ask me something, never to report work done.]`
(narrowed 2026-10-08: a "done, refresh Gmail" after a request phrased as a question
was a modal he had no need of).
This posts the answer to the running Walkie Talkie (`POST /reply` on 127.0.0.1:8917–8919,
with the token from ~/.walkie-talkie/reply-token) and `ReplyPanel` shows it next to his
pointer. Linked into ~/.local/bin. Stdlib only.
"""
import json
import os
import subprocess
import sys
import urllib.request

args, images = [], []
argv = sys.argv[1:]
while argv:
    a = argv.pop(0)
    if a in ("--image", "-i"):
        if not argv:
            sys.exit("walkie-reply: --image needs a path")
        path = os.path.abspath(os.path.expanduser(argv.pop(0)))
        if not os.path.isfile(path):
            sys.exit(f"walkie-reply: no such image: {path}")
        images.append(path)
    else:
        args.append(a)
text = " ".join(args).strip() or ("" if images else sys.stdin.read().strip())
if not text and not images:
    sys.exit("usage: walkie-reply \"<answer>\" [--image <path>]…")
try:
    token = open(os.path.expanduser("~/.walkie-talkie/reply-token")).read().strip()
except OSError:
    sys.exit("walkie-reply: Walkie Talkie has not made ~/.walkie-talkie/reply-token yet")
try:
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=2).stdout.strip()
except Exception:
    top = ""
def session_tty():
    """The terminal of the agent asking: walk up from this process to the first
    ancestor with a tty (the Bash tool's shell has none; `claude` does)."""
    pid = os.getppid()
    for _ in range(12):
        try:
            out = subprocess.run(["ps", "-o", "tty=,ppid=", "-p", str(pid)],
                                 capture_output=True, text=True, timeout=2).stdout.split()
        except Exception:
            return None
        if len(out) < 2:
            return None
        if out[0].startswith("ttys"):
            return out[0]
        pid = int(out[1])
        if pid <= 1:
            return None
    return None


body = json.dumps({"token": token, "text": text, "from": os.path.basename(top or os.getcwd()),
                   "tty": session_tty(), "images": images}).encode()
for port in (8917, 8918, 8919):
    try:
        req = urllib.request.Request(f"http://127.0.0.1:{port}/reply", data=body,
                                     headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=2) as r:
            if r.status == 200:
                print("shown")
                sys.exit(0)
    except Exception:
        continue
sys.exit("walkie-reply: no Walkie Talkie answered on 8917–8919")
