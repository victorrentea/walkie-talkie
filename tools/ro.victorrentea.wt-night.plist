<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PARKED in ~/Library/LaunchAgents.disabled since 2026-09-29 (on demand only). Was: every night at 02:00,
  `tools/wt-night.sh start`, which ran only when the last automatic run is ≥ 6 d 12 h old, no `wt-night` tmux is
  live and the hour is 01–05; then an interactive Claude Code session in tmux `wt-night` runs the
  suite in the Tart guest (brief: evals/plan/vm/night/PROMPT.md). See docs/vm-lab.md, *Nightly*.

  - A Mac asleep at 02:00 gets the trigger at wake (launchd coalesces missed calendar events); the
    01–05 hour check in `gate` turns a 09:00 wake into a logged refusal instead of a day-time VM boot.
  - AbandonProcessGroup: the tmux server and its claude outlive this job's short script.
  - Install: ln -s "$PWD/tools/ro.victorrentea.wt-night.plist" ~/Library/LaunchAgents/ &&
             launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ro.victorrentea.wt-night.plist
  - Disable: launchctl bootout gui/$(id -u)/ro.victorrentea.wt-night
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>ro.victorrentea.wt-night</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/victorrentea/workspace/walkie-talkie/tools/wt-night.sh</string>
    <string>start</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/victorrentea/workspace/walkie-talkie</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/victorrentea/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>TART_HOME</key><string>/Users/victorrentea/tart</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>/Users/victorrentea/.walkie-talkie/night/launchagent.log</string>
  <key>StandardErrorPath</key><string>/Users/victorrentea/.walkie-talkie/night/launchagent.log</string>
</dict>
</plist>
